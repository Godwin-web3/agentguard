{
  "name": "@agentguard-dev/intent-verifier",
  "version": "0.1.1",
  "description": "Verify AgentGuard Proof-of-Intent receipts offline: the buyer's passkey-signed mandate, the PayPal order it paid, and the issuer attestation. Builds PayPal dispute evidence.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.6"
  },
  "bin": {
    "intent-verify": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "verify": "node --experimental-strip-types --no-warnings src/cli.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^22.20.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Godwin-web3/agentguard.git",
    "directory": "packages/intent-verifier"
  },
  "homepage": "https://agentguard-orcin.vercel.app",
  "bugs": {
    "url": "https://github.com/Godwin-web3/agentguard/issues"
  }
}
