{
  "name": "agentguard",
  "version": "0.1.0",
  "description": "Financial authorization gateway for AI agents that pay through PayPal: scoped, signed spending mandates enforced deterministically before any money moves.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "node --experimental-strip-types --no-warnings src/server.ts",
    "test": "node --experimental-strip-types --no-warnings --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.all.json",
    "test:toolkit": "cd packages/paypal-toolkit && npm ci && npm run build && npm test",
    "build:vercel": "node scripts/build-vercel.mjs",
    "lint": "eslint src test scripts api",
    "test:pg": "AGENTGUARD_TEST_PG=${AGENTGUARD_TEST_PG:-postgres://postgres@127.0.0.1:55432/postgres} node --experimental-strip-types --no-warnings --test test/*.test.ts"
  },
  "dependencies": {
    "@simplewebauthn/server": "^14.0.3",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "playwright-core": "^1.64.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
