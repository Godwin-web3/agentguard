# Copy to .env and fill in. Never commit .env.
# PayPal REST app (sandbox): https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Owner token for the admin API and console, 24+ characters (e.g. `openssl rand -hex 24`).
AGENTGUARD_ADMIN_TOKEN=

# Public origin; also the WebAuthn origin and RP ID.
AGENTGUARD_PUBLIC_URL=http://localhost:8787
PORT=8787

# Storage (SQLite by default). Set AGENTGUARD_DATABASE_URL for Postgres.
AGENTGUARD_DB=./data/agentguard.db
AGENTGUARD_KEYRING_FILE=./data/issuer-keys.json
# AGENTGUARD_DATABASE_URL=postgres://...
# AGENTGUARD_KEYRING_KEY=   # 32+ chars; required with Postgres

# Optional
# AGENTGUARD_TSA_URLS=freetsa=https://freetsa.org/tsr   # name=url,name=url; empty disables timestamps
# AGENTGUARD_NOTIFY_WEBHOOK=
# AGENTGUARD_PUBLIC_RECEIPTS=1
# LLM_API_KEY=
